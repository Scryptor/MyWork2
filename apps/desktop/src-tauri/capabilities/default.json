{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Окно программы на адресе встроенного сервера: только выбор папки и события окна.",
	"windows": ["main"],
	"remote": {
		"urls": ["http://127.0.0.1:*"]
	},
	"permissions": ["core:event:allow-listen", "core:event:allow-unlisten", "dialog:allow-open"]
}
