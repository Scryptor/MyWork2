{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "MyWork",
	"version": "0.0.2",
	"identifier": "io.github.scryptor.mywork3",
	"build": {
		"beforeDevCommand": { "script": "npm run build", "cwd": "../../ui", "wait": true },
		"beforeBuildCommand": { "script": "npm run build", "cwd": "../../ui" }
	},
	"app": {
		"windows": [],
		"security": {
			"capabilities": ["default"]
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"resources": {
			"../../ui/build/": "ui/"
		}
	}
}
