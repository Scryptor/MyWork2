{
	"name": "mywork-ui",
	"version": "0.0.3",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "npm run build && playwright test",
		"licenses": "node scripts/check-licenses.mjs",
		"playwright-image": "node scripts/check-playwright-image.mjs",
		"verify": "npm run check && npm run lint && npm run test && npm run build && npm run licenses && npm run playwright-image"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "1.65.1",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/svelte": "5.4.2",
		"@testing-library/user-event": "14.6.10",
		"@types/node": "^24",
		"eslint": "10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "^17.6.0",
		"jsdom": "31.0.1",
		"prettier": "3.10.1",
		"prettier-plugin-svelte": "4.1.1",
		"svelte-check": "4.7.8",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.2",
		"vite": "8.3.8",
		"vitest": "5.1.0"
	},
	"dependencies": {
		"@fontsource-variable/inter": "5.3.0",
		"@internationalized/date": "3.12.4",
		"@lucide/svelte": "1.73.0",
		"@sveltejs/kit": "3.2.0",
		"@tanstack/svelte-virtual": "3.13.52",
		"@tauri-apps/api": "2.12.5",
		"@tauri-apps/plugin-dialog": "2.8.4",
		"bits-ui": "2.21.0",
		"echarts": "6.1.0",
		"svelte": "5.57.3"
	},
	"engines": {
		"node": ">=22.17"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"overrides": {
		"runed": {
			"@sveltejs/kit": "$@sveltejs/kit"
		}
	}
}
