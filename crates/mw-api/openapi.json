        "summary": "Изменение статуса: название, цвет, архивация (право `settings_manage`).",
        "operationId": "update_status",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Номер статуса",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StatusPatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Статус после изменения",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    }
  },
